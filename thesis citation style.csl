<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl"
       version="1.0"
       class="in-text"
       default-locale="en-US"
       demote-non-dropping-particle="never"
       initialize-with=" "
       page-range-format="expanded"
       name-delimiter=", "
       names-delimiter=", "
       delimiter-precedes-last="always">

  <info>
    <title>Custom English Numeric Thesis Style MJD</title>
    <title-short>English Numeric MJD</title-short>
    <id>http://www.zotero.org/styles/custom-english-numeric-thesis-style-mjd</id>
    <link href="http://www.zotero.org/styles/custom-english-numeric-thesis-style-mjd" rel="self"/>
    <author>
      <name>OpenAI</name>
    </author>
    <category citation-format="numeric"/>
    <category field="generic-base"/>
    <summary>Custom numeric style with [M], [J], and [D] type codes for books, journal articles, and dissertations.</summary>
    <updated>2026-03-16T00:00:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>

  <macro name="author">
    <names variable="author">
      <name name-as-sort-order="all" sort-separator=" " initialize-with=" " delimiter=", "/>
      <substitute>
        <names variable="editor"/>
      </substitute>
    </names>
  </macro>

  <macro name="title">
    <text variable="title"/>
  </macro>

  <macro name="type-code">
    <choose>
      <if type="book">
        <text value="[M]"/>
      </if>
      <else-if type="article-journal">
        <text value="[J]"/>
      </else-if>
      <else-if type="thesis">
        <text value="[D]"/>
      </else-if>
      <else>
        <text value="[Z]"/>
      </else>
    </choose>
  </macro>

  <macro name="year">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>

  <macro name="place-publisher">
    <group delimiter=": ">
      <text variable="publisher-place"/>
      <text variable="publisher"/>
    </group>
  </macro>

  <macro name="journal-info">
    <group delimiter=", ">
      <text variable="container-title"/>
      <text macro="year"/>
      <group>
        <text variable="volume"/>
        <group prefix="(" suffix=")">
          <text variable="issue"/>
        </group>
      </group>
    </group>
  </macro>

  <macro name="pages">
    <text variable="page"/>
  </macro>

  <citation collapse="citation-number">
    <layout prefix="[" suffix="]" delimiter=", ">
      <text variable="citation-number"/>
    </layout>
  </citation>

  <bibliography entry-spacing="0" second-field-align="flush">
    <layout suffix=".">
      <text variable="citation-number" prefix="[" suffix="] "/>
      <text macro="author" suffix=". "/>
      <text macro="title" suffix=" "/>
      <text macro="type-code" suffix=". "/>

      <choose>
        <if type="book">
          <text macro="place-publisher"/>
          <text macro="year" prefix=", "/>
          <text macro="pages" prefix=", "/>
        </if>

        <else-if type="article-journal">
          <text macro="journal-info"/>
          <text macro="pages" prefix=": "/>
        </else-if>

        <else-if type="thesis">
          <text macro="place-publisher"/>
          <text macro="year" prefix=", "/>
        </else-if>

        <else>
          <text macro="year"/>
        </else>
      </choose>
    </layout>
  </bibliography>
</style>