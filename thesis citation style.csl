<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl"
       version="1.0"
       class="in-text"
       default-locale="en-US"
       demote-non-dropping-particle="never"
       initialize-with=" "
       page-range-format="expanded"
       name-delimiter=", "
       names-delimiter=", "
       delimiter-precedes-last="always">

  <info>
    <title>Custom Thesis Numeric Style M-J-D</title>
    <title-short>MJD Thesis Style</title-short>
    <id>http://www.zotero.org/styles/custom-thesis-numeric-mjd</id>
    <link href="http://www.zotero.org/styles/custom-thesis-numeric-mjd" rel="self"/>
    <author>
      <name>OpenAI</name>
    </author>
    <category citation-format="numeric"/>
    <summary>Custom numeric thesis style for books [M], journal articles [J], and dissertations [D].</summary>
    <updated>2026-03-16T00:00:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">
      This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License
    </rights>
  </info>

  <macro name="author">
    <names variable="author">
      <name name-as-sort-order="all" sort-separator=" " initialize-with=" " delimiter=", "/>
      <substitute>
        <names variable="editor"/>
      </substitute>
    </names>
  </macro>

  <macro name="year">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>

  <macro name="title-with-type">
    <group delimiter=" ">
      <text variable="title"/>
      <choose>
        <if type="book">
          <text value="[M]"/>
        </if>
        <else-if type="article-journal">
          <text value="[J]"/>
        </else-if>
        <else-if type="thesis">
          <text value="[D]"/>
        </else-if>
      </choose>
    </group>
  </macro>

  <macro name="book-details">
    <group delimiter="">
      <group delimiter=": ">
        <text variable="publisher-place"/>
        <text variable="publisher"/>
      </group>
      <text macro="year" prefix=", "/>
      <text variable="page" prefix=", "/>
    </group>
  </macro>

  <macro name="journal-details">
    <group delimiter="">
      <text variable="container-title"/>
      <text macro="year" prefix=", "/>
      <group prefix=", ">
        <text variable="volume"/>
        <group prefix="(" suffix=")">
          <text variable="issue"/>
        </group>
      </group>
      <text variable="page" prefix=": "/>
    </group>
  </macro>

  <macro name="thesis-details">
    <group delimiter="">
      <group delimiter=": ">
        <text variable="publisher-place"/>
        <text variable="publisher"/>
      </group>
      <text macro="year" prefix=", "/>
    </group>
  </macro>

  <citation collapse="citation-number">
    <layout prefix="[" suffix="]" delimiter=", ">
      <text variable="citation-number"/>
    </layout>
  </citation>

  <bibliography entry-spacing="0" second-field-align="flush">
    <layout suffix=".">
      <text variable="citation-number" prefix="[" suffix="] "/>
      <text macro="author" suffix=". "/>
      <text macro="title-with-type" suffix=". "/>

      <choose>
        <if type="book">
          <text macro="book-details"/>
        </if>
        <else-if type="article-journal">
          <text macro="journal-details"/>
        </else-if>
        <else-if type="thesis">
          <text macro="thesis-details"/>
        </else-if>
      </choose>
    </layout>
  </bibliography>
</style>