<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl"
       version="1.0"
       class="in-text"
       default-locale="en-US"
       demote-non-dropping-particle="never"
       initialize-with=" "
       page-range-format="expanded"
       name-delimiter=", "
       names-delimiter=", "
       delimiter-precedes-last="always">

  <info>
    <title>Custom Numeric Thesis Style [M][J][D]</title>
    <title-short>Numeric Thesis MJD</title-short>
    <id>http://www.zotero.org/styles/custom-numeric-thesis-mjd</id>
    <link href="http://www.zotero.org/styles/custom-numeric-thesis-mjd" rel="self"/>
    <author>
      <name>OpenAI</name>
    </author>
    <category citation-format="numeric"/>
    <category field="generic-base"/>
    <summary>
      Numeric citation style with bibliography formats for books [M], journal articles [J], and dissertations [D].
    </summary>
    <updated>2026-03-16T00:00:00+00:00</updated>
  </info>

  <locale xml:lang="en">
    <terms>
      <term name="edition" form="short">ed.</term>
      <term name="page" form="short">p.</term>
      <term name="number-of-pages" form="short">pp.</term>
    </terms>
  </locale>

  <!-- ========== MACROS ========== -->

  <macro name="author">
    <names variable="author">
      <name and="text" initialize-with="" name-as-sort-order="all" sort-separator=" " delimiter=", " delimiter-precedes-last="always"/>
      <substitute>
        <names variable="editor"/>
        <text variable="publisher"/>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>

  <macro name="title">
    <text variable="title"/>
  </macro>

  <macro name="container-title">
    <text variable="container-title"/>
  </macro>

  <macro name="volume-issue">
    <group>
      <text variable="volume"/>
      <group prefix="(" suffix=")">
        <text variable="issue"/>
      </group>
    </group>
  </macro>

  <macro name="publisher-place">
    <text variable="publisher-place"/>
  </macro>

  <macro name="publisher">
    <text variable="publisher"/>
  </macro>

  <macro name="issued-year">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>

  <macro name="pages">
    <text variable="page"/>
  </macro>

  <macro name="type-code">
    <choose>
      <if type="book chapter paper-conference entry-encyclopedia entry-dictionary" match="any">
        <text value="[M]"/>
      </if>
      <else-if type="article-journal article-magazine article-newspaper" match="any">
        <text value="[J]"/>
      </else-if>
      <else-if type="thesis">
        <text value="[D]"/>
      </else-if>
      <else>
        <text value="[M]"/>
      </else>
    </choose>
  </macro>

  <!-- ========== CITATION ========== -->

  <citation collapse="citation-number" after-collapse-delimiter=", ">
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout prefix="[" suffix="]" delimiter=", ">
      <text variable="citation-number"/>
    </layout>
  </citation>

  <!-- ========== BIBLIOGRAPHY ========== -->

  <bibliography entry-spacing="0" line-spacing="1" second-field-align="flush">
    <layout>
      <text variable="citation-number" prefix="[" suffix="] "/>

      <choose>

        <!-- BOOK FORMAT -->
        <if type="book chapter paper-conference entry-encyclopedia entry-dictionary" match="any">
          <group delimiter=". ">
            <text macro="author"/>
            <group delimiter=" ">
              <text macro="title"/>
              <text macro="type-code"/>
            </group>
            <group delimiter=", ">
              <group delimiter=": ">
                <text macro="publisher-place"/>
                <text macro="publisher"/>
              </group>
              <text macro="issued-year"/>
              <text macro="pages"/>
            </group>
          </group>
          <text value="."/>
        </if>

        <!-- JOURNAL ARTICLE FORMAT -->
        <else-if type="article-journal article-magazine article-newspaper" match="any">
          <group delimiter=". ">
            <text macro="author"/>
            <group delimiter=" ">
              <text macro="title"/>
              <text macro="type-code"/>
            </group>
            <group delimiter=", ">
              <text macro="container-title"/>
              <text macro="issued-year"/>
              <group delimiter=": ">
                <text macro="volume-issue"/>
                <text macro="pages"/>
              </group>
            </group>
          </group>
          <text value="."/>
        </else-if>

        <!-- DISSERTATION FORMAT -->
        <else-if type="thesis">
          <group delimiter=". ">
            <text macro="author"/>
            <group delimiter=" ">
              <text macro="title"/>
              <text macro="type-code"/>
            </group>
            <group delimiter=", ">
              <group delimiter=": ">
                <text macro="publisher-place"/>
                <text macro="publisher"/>
              </group>
              <text macro="issued-year"/>
            </group>
          </group>
          <text value="."/>
        </else-if>

        <!-- FALLBACK FORMAT -->
        <else>
          <group delimiter=". ">
            <text macro="author"/>
            <group delimiter=" ">
              <text macro="title"/>
              <text macro="type-code"/>
            </group>
            <group delimiter=", ">
              <group delimiter=": ">
                <text macro="publisher-place"/>
                <text macro="publisher"/>
              </group>
              <text macro="issued-year"/>
              <text macro="pages"/>
            </group>
          </group>
          <text value="."/>
        </else>

      </choose>
    </layout>
  </bibliography>
</style>